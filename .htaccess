<IfModule mod_rewrite.c>
    RewriteEngine On

    # Collapse legacy /public/* duplicates (indexed by Search Console) onto
    # the canonical root URLs with a permanent redirect. THE_REQUEST keeps
    # this rule from firing again on the internal rewrite below.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+public(?:/|\s|\?)
    RewriteRule ^public/?(.*)$ /$1 [L,R=301]

    # Direct all incoming traffic to the /public directory on Hostinger/cPanel
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
