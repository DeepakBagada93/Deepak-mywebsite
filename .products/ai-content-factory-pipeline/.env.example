# LLM Providers (Claude 3.5 Sonnet / OpenAI GPT-4o / Perplexity)
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_API_KEY
OPENAI_API_KEY=sk-proj-REPLACE_WITH_OPENAI_API_KEY
PERPLEXITY_API_KEY=pplx-REPLACE_WITH_PERPLEXITY_API_KEY

# CMS Integration Keys (Choose WordPress, Webflow, or Ghost)
CMS_PLATFORM=wordpress
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USER=editor_account
WORDPRESS_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
WEBFLOW_API_TOKEN=REPLACE_WITH_WEBFLOW_TOKEN
WEBFLOW_COLLECTION_ID=REPLACE_WITH_COLLECTION_ID

# Review & Publishing Control Webhook
SLACK_APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/SLACK_WEBHOOK
AUTO_PUBLISH_DEFAULT=false

# System & Infrastructure
PORT=5680
EXECUTION_TIMEOUT_MS=60000
POSTGRES_USER=content_n8n
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=n8n_content_factory
