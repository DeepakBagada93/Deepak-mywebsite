# ==============================================================================
# AI LEAD INTELLIGENCE ENGINE — ENVIRONMENT CONFIGURATION
# Copy to .env in your root or load into your n8n / Make environment.
# ==============================================================================

# LLM Providers (OpenAI GPT-4o / Claude 3.5 Sonnet)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_OPENAI_API_KEY
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_API_KEY
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.2

# CRM Connection (HubSpot / Salesforce / Monday)
CRM_PLATFORM=hubspot
HUBSPOT_ACCESS_TOKEN=pat-na1-REPLACE_WITH_HUBSPOT_PRIVATE_TOKEN
SALESFORCE_ACCESS_TOKEN=REPLACE_WITH_SALESFORCE_TOKEN
SALESFORCE_INSTANCE_URL=https://your-instance.my.salesforce.com

# Alerting & Human-in-the-Loop Webhooks
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/SLACK_WEBHOOK
HIGH_INTENT_THRESHOLD=80

# System Settings
ENVIRONMENT=production
EXECUTION_TIMEOUT_MS=15000
MAX_RETRIES=3

# Self-Hosted n8n Stack Config (If running with Docker Compose)
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_32_char_random_hex_key
WEBHOOK_URL=https://n8n.yourdomain.com/
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=n8n_lead_engine
