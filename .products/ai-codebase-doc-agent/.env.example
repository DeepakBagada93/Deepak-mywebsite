# AI Codebase Doc Agent — Configuration

# Output preferences
DOC_OUTPUT_PATH=docs
DOC_LANGUAGE=english
DOC_STYLE=standard
DOC_TYPES=readme,api,adr,onboarding

# Scan preferences
DOC_MAX_DEPTH=10
DOC_EXCLUDE_PATTERNS=node_modules,vendor,.git,dist,build,__pycache__,*.min.js,.next,.cache
DOC_INCLUDE_PATTERNS=**/*.{js,ts,py,rs,go,java,cs,php,rb,c,cpp,h,hpp,swift,kt,tsx,jsx,sql,yaml,yml,toml,json}

# Behavior
DOC_BACKUP_EXISTING=true
DOC_SHOW_PROGRESS=true
DOC_INCLUDE_SECRET_WARNINGS=true

# AI Provider (leave blank to use host CLI's default provider)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-20250514