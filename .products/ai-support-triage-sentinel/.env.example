# ==============================================================================
# AI SUPPORT TRIAGE SENTINEL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Providers (Claude 3.5 Sonnet / OpenAI GPT-4o)
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_API_KEY
OPENAI_API_KEY=sk-proj-REPLACE_WITH_OPENAI_API_KEY
AI_MODEL=claude-3-5-sonnet-20241022
TEMPERATURE=0.1

# Helpdesk Integration (Zendesk / Freshdesk / Intercom)
HELPDESK_PLATFORM=zendesk
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_API_TOKEN=REPLACE_WITH_ZENDESK_TOKEN
ZENDESK_ADMIN_EMAIL=support-admin@yourcompany.com

# Urgent Notification & Escalation Channel
SLACK_ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/SLACK_WEBHOOK
URGENT_SENTIMENT_THRESHOLD=0.35

# System Settings
PORT=5679
EXECUTION_TIMEOUT_MS=15000
POSTGRES_USER=support_n8n
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=n8n_support_sentinel
