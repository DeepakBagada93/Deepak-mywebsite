# ============================================================
# AGENCY AI EMAIL ENGINE — ENVIRONMENT CONFIGURATION
# Copy to .env and replace every placeholder before use.
# Never commit the real .env file.
# ============================================================

# AI provider
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Public URL of your n8n instance (no trailing slash)
N8N_PUBLIC_URL=https://n8n.your-agency.com
N8N_HOST=n8n.your-agency.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.your-agency.com/

# Slack destinations
SLACK_REVIEW_CHANNEL_ID=REPLACE_WITH_SLACK_CHANNEL_ID
SLACK_ALERT_CHANNEL_ID=REPLACE_WITH_SLACK_ALERT_CHANNEL_ID

# Postgres (used by n8n and the schema)
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=n8n
AGENCY_EMAIL_DB=agency_email

# n8n runtime
N8N_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_KEY
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Sending limits
DAILY_EMAIL_CAP=45
FOLLOWUP_1_DELAY_DAYS=4
FOLLOWUP_2_DELAY_DAYS=5
APPROVAL_TOKEN_TTL_DAYS=7
