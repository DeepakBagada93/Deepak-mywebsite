{
  "name": "Agency AI Email Engine — Approval, Send & Follow-up",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "agency-email-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node_approval_webhook",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 300],
      "webhookId": "agency-email-approval"
    },
    {
      "parameters": {
        "jsCode": "const q = $input.item.json.query || {};\nconst recordId = String(q.record || '').trim();\nconst token = String(q.token || '').trim();\nconst decision = String(q.decision || '').trim().toLowerCase();\nif (!recordId || !token) throw new Error('Missing record or token.');\nif (!['approve', 'reject'].includes(decision)) throw new Error('Decision must be approve or reject.');\nreturn { json: { record_id: recordId, approval_token: token, decision } };"
      },
      "id": "node_validate_request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, contact_id, email, company, subject, preview_text, body, followup_1, followup_2, approval_token, status, created_at FROM agency_email_drafts WHERE id = $1 AND approval_token = $2 AND created_at > NOW() - INTERVAL '7 days' LIMIT 1;",
        "queryReplacement": "={{ [$('Validate Request').item.json.record_id, $('Validate Request').item.json.approval_token] }}",
        "options": {}
      },
      "id": "node_load_draft",
      "name": "Load Draft",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [220, 300],
      "credentials": {
        "postgres": {
          "id": "CREDENTIAL_POSTGRES",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.item.json;\nif (!row || !row.id) throw new Error('Draft not found, token expired, or token mismatch.');\nif (row.status !== 'pending_review') throw new Error('Draft is not pending review. Current status: ' + row.status);\nconst decision = $('Validate Request').item.json.decision;\nreturn {\n  json: {\n    ...row,\n    decision,\n    approved: decision === 'approve',\n    reply_subject: row.subject.startsWith('Re:') ? row.subject : 'Re: ' + row.subject\n  }\n};"
      },
      "id": "node_authorize",
      "name": "Authorize & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_approved",
              "leftValue": "={{ $json.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node_approved_if",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "node_gmail_send",
      "name": "Send Approved Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [940, 160],
      "credentials": {
        "gmailOAuth2": {
          "id": "CREDENTIAL_GMAIL_OAUTH",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agency_email_drafts SET status = 'sent', sent_at = NOW() WHERE id = $1 RETURNING id, status;",
        "queryReplacement": "={{ [$('Authorize & Prepare').item.json.id] }}",
        "options": {}
      },
      "id": "node_mark_sent",
      "name": "Mark Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1180, 160],
      "credentials": {
